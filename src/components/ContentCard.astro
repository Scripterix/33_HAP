---
interface Props {
  eyebrow: string;
  title: string;
  href: string;
  description: string;
  headingLevel?: 'h2' | 'h3';
  publishedAt?: string;
}

const { eyebrow, title, href, description, headingLevel = 'h2', publishedAt } = Astro.props;
const Heading = headingLevel;
const publishedDate = publishedAt && !Number.isNaN(Date.parse(publishedAt))
  ? new Date(`${publishedAt}T00:00:00Z`)
  : null;
const dateLabel = publishedDate
  ? new Intl.DateTimeFormat('pl-PL', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(publishedDate)
  : null;
---

<article class="content-card" data-published-at={publishedAt}>
  <div class="card-copy">
    <p class="eyebrow">{eyebrow}</p>
    <Heading class="card-title"><a href={href}>{title}</a></Heading>
    <p class="card-description">{description}</p>
    <slot name="meta" />
  </div>
  <div class="card-footer">
    <div class="card-actions"><slot name="actions" /></div>
    {publishedDate && dateLabel && <time class="card-date" datetime={publishedAt}>{dateLabel}</time>}
  </div>
</article>
